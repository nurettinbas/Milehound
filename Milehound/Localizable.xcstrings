    "label.avg_fuel.help.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catalog cost: distance × the average consumption for this vehicle × unit price. It does not look at this trip’s GPS. Change the average in Settings or here; Estimated fuel is the GPS version."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katalog: mesafe × bu aracın ortalama tüketimi × birim fiyat. Bu yolculuğun GPS’ine bakmaz. Ortalamayı Ayarlar veya buradan değiştirirsin; Tahmini yakıt GPS’li olandır."
          }
        }
      }
    },
    "label.avg_fuel.help.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What is average fuel?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ortalama yakıt nedir?"
          }
        }
      }
    },
    "label.cruise_speed" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cruise speed"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seyir hızı"
          }
        }
      }
    },
    "label.cruise_speed.help.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cruise is your average speed while the car was moving — stop time is left out. That is why it is usually higher than overall average speed when you waited at lights or in traffic."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seyir hızı, araç hareket halindeyken ortalama hızındır — durma süresi sayılmaz. Işıkta veya trafikte beklediysen genel ortalamadan genelde daha yüksektir."
          }
        }
      }
    },
    "label.cruise_speed.help.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What is cruise speed?"
          }
