    "label.dynamic_fuel" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Est. fuel"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tah. yakıt"
          }
        }
      }
    },
    "label.dynamic_fuel.help.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starts from the average you set for this vehicle. Then it looks at this trip: speeds, waiting, hard acceleration, and whether the engine was likely cold. Short stop-go usually uses more than your average; a steady highway trip usually uses less. Not a pump reading. A Stop pin on the map does not mean the engine was off."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu araç için girdiğin ortalamadan başlar. Bu yolculuğun hızına, beklemene, sert gaza ve motorun soğuk olup olmadığına bakar. Kısa dur-kalk genelde ortalamanın üstü, akıcı yol altıdır. Pompa ölçümü değildir. Haritadaki Stop pini motorun kapalı olduğu anlamına gelmez."
          }
        }
      }
    },
    "label.dynamic_fuel.help.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What is estimated fuel?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahmini yakıt nedir?"
          }
        }
      }
    },
    "label.estimated_fuel" : {
      "extractionState" : "stale",
