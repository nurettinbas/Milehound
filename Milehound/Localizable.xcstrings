    "settings.report_problem.disclosure" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The attachment includes recent recording events: times, start/stop, speed, distance, GPS accuracy, and Bluetooth or Live Activity messages. It does not include map coordinates, addresses, place or vehicle names, photos, or notes. You can edit or remove the file before sending. Logs older than 30 days are already deleted on this device."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ek, son kayıt olaylarını içerir: zamanlar, başlat/durdur, hız, mesafe, GPS doğruluğu ve Bluetooth veya Live Activity mesajları. Harita koordinatı, adres, yer veya araç adı, fotoğraf ve not yoktur. Göndermeden dosyayı düzenleyebilir veya kaldırabilirsin. 30 günden eski günlükler bu cihazda zaten silinir."
          }
        }
      }
    },
    "settings.report_problem.failed.message" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The diagnostic file could not be created. Try again, or email support and describe the issue without a log."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanı dosyası oluşturulamadı. Yeniden dene veya günlüksüz olarak destek adresine yaz."
          }
        }
      }
    },
    "settings.report_problem.failed.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
