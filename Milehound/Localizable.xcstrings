    "stats.dynamic_fuel.help.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starts from the average you set for each vehicle. Then it looks at each trip: speeds, waiting, hard acceleration, and whether the engine was likely cold. This is the total for the selected period. Not a pump reading."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her araç için girdiğin ortalamadan başlar. Her yolculuğun hızına, beklemene, sert gaza ve soğuk motora bakar. Seçilen dönemdeki toplamdır. Pompa ölçümü değildir."
          }
        }
      }
    },
