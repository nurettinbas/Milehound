    "label.measured_fuel.help.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you change L/100 here, Milehound treats it as what this trip actually used. It does not replace your vehicle average and it is not Estimated fuel. Over time it helps the estimate learn your car."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buradaki L/100’ü değiştirirsen bu yolculuğun gerçek tüketimi sayılır. Araç ortalamanın yerine geçmez; Tahmini yakıt da değildir. Zamanla tahmin senin arabana alışır."
          }
        }
      }
    },
    "label.measured_fuel.help.title" : {
      "extractionState" : "manual",
      "localizations" : {
