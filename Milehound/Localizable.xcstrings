    "stats.compare.vehicles_help.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is the sum of expenses you logged for each vehicle in this period (fuel, insurance, service, and the rest under Pairing). Trip estimated fuel from GPS is not included. Cost per km divides that total by distance driven in the same period. Installments count in the month each slice falls on."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, Pairing’de her araç için kaydettiğin giderlerin bu dönemdeki toplamıdır (yakıt, sigorta, servis ve diğerleri). Yolculuk tahmini yakıtı (GPS) dahil değildir. km başı maliyet, bu toplamı aynı dönemdeki mesafeye böler. Taksitler, her dilimin düştüğü ayda sayılır."
          }
        }
      }
    },
    "stats.compare.vehicles_help.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
