    "settings.siri.shortcuts_hint" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Say \"Start trip\", \"Pause trip\", \"Resume trip\", or \"End trip\" to Siri. In Shortcuts, use only these four actions — ignore any Turkish \"Kaydı…\" entries (those are for the widget)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri'ye \"Yolculuğu başlat\", \"Yolculuğu duraklat\", \"Yolculuğu sürdür\", \"Yolculuğu bitir\" de. Kısayollar'da Start/Pause/Resume/End trip kullan — Türkçe \"Kaydı…\" olanlar widget içindir."
          }
        }
      }
    },
