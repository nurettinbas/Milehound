            "state" : "translated",
            "value" : "Ort. yakıt"
          }
        }
      }
    },
    "label.fuel_efficiency" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Driving efficiency"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sürüş verimi"
          }
        }
      }
    },
    "label.fuel_efficiency.help.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How economical this trip was versus your vehicle average. Around 80 is typical for you. Lower means this trip used more than usual (traffic, short cold start, high speed). Higher means easier than your average."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu yolculuğun, senin araç ortalamana göre ne kadar ekonomik olduğu. 80 civarı senin normalin. Daha düşük: trafik, kısa soğuk çalışma veya yüksek hız. Daha yüksek: ortalamadan hafif."
          }
        }
      }
    },
