    "settings.tip_jar.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Milehound is free, with no ads and no tracking. If it helps you, you can leave an optional tip. A tip unlocks nothing; every feature stays the same. Apple handles the payment."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Milehound ücretsizdir; reklam ve izleme yoktur. İşine yarıyorsa isteğe bağlı destek bırakabilirsin. Destek hiçbir özellik açmaz; her şey aynı kalır. Ödemeyi Apple yönetir."
          }
        }
